{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/leanverifier/schemas/result.schema.json",
  "title": "LeanVerifierVerificationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "exit_code",
    "claim",
    "model_digest",
    "request_digest",
    "generator_version",
    "lean_toolchain",
    "mathlib_revision",
    "theorem",
    "build_exit_code",
    "axiom_audit_exit_code",
    "axiom_audit",
    "evidence_bundle_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "leanverifier.result.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "not-certified",
        "invalid-input",
        "build-failure",
        "axiom-failure",
        "digest-mismatch",
        "internal-error",
        "timeout"
      ]
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 2, 3, 4, 5, 6, 7, 8]
    },
    "claim": {
      "type": "string",
      "const": "local_linf_binary_classification_robustness"
    },
    "model_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generator_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "mathlib_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "theorem": {
      "type": "string",
      "const": "LeanVerifier.AffineBinaryClassifier.affine_margin_robustness"
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    },
    "generated_module": {
      "type": "string",
      "pattern": "^GeneratedModel_[0-9a-f]{16}$"
    },
    "generated_module_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "build_exit_code": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 255
    },
    "axiom_audit_exit_code": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 255
    },
    "axiom_audit": {
      "type": "string",
      "enum": ["passed", "failed", "not-run"]
    },
    "evidence_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
