{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/leanverifier/schemas/model.schema.json",
  "title": "LeanVerifierAffineBinaryModel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_kind", "dimension", "weights", "bias"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "leanverifier.model.v1"
    },
    "model_kind": {
      "type": "string",
      "const": "affine_binary"
    },
    "dimension": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "weights": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^(0|-?[1-9][0-9]*|-?[1-9][0-9]*/[1-9][0-9]*)$"
      }
    },
    "bias": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*|-?[1-9][0-9]*/[1-9][0-9]*)$"
    },
    "comment": {
      "type": "string",
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "description": "weights length must equal dimension (enforced in parser)"
    }
  ]
}
